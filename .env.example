# MedVoice AI Backend Environment Template
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_URL=http://localhost:3001

# Platform bootstrap
PLATFORM_SEED_TENANTS=true
PLATFORM_ADMIN_EMAIL=admin@medvoice.local
PLATFORM_ADMIN_PASSWORD=changeme-dev-only
PLATFORM_CLINIC_EMAIL=clinic@medical-clinic.local
PLATFORM_REQUIRE_AUTH=false

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Vapi (Phase 1.5 spike — set before ngrok call)
# Use the PRIVATE key from dashboard (Server-side API access) — NOT the Public Key
# VAPI_API_KEY=your-private-key-here
VAPI_WEBHOOK_SECRET=generate-a-long-random-string
VAPI_SPIKE_MODE=true
# VAPI_CAPTURE_ENABLED=true
# VAPI_WEBHOOK_HMAC=true
# VAPI_LLM_MODEL=gpt-4o

# Client Webhooks
MEDICAL_CLINIC_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/medical
MEDICAL_CLINIC_WEBHOOK_SECRET=your-256-bit-hmac-secret

# LLM Configuration
OLLAMA_ENDPOINT=http://localhost:11434

# Google Calendar API (Service Account)
G_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
G_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
G_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar

# Twilio Voice
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
PUBLIC_URL=https://your-domain.com
DOMAIN=your-domain.com
