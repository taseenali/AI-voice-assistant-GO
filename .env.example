# MedVoice AI — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env.

# ─── SERVER ────────────────────────────────────────────────────────────────
PORT=3001
# Public URL of this server — used by Vapi to reach webhook endpoints.
# Dev: use ngrok output. Production: your Railway/Render URL.
PUBLIC_URL=https://your-server.up.railway.app

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed dashboard origins.
# Dev: include localhost ports. Production: your Vercel URL.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-dashboard.vercel.app

# ─── PLATFORM BOOTSTRAP ────────────────────────────────────────────────────
PLATFORM_SEED_TENANTS=true
PLATFORM_ADMIN_EMAIL=admin@medvoice.local
PLATFORM_ADMIN_PASSWORD=changeme-dev-only
PLATFORM_CLINIC_EMAIL=clinic@medical-clinic.local
# Set to true in production to block all unauthenticated non-Vapi routes.
PLATFORM_REQUIRE_AUTH=false

# ─── AUTH ──────────────────────────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── VAPI ──────────────────────────────────────────────────────────────────
# Private key from Vapi dashboard → API Keys → Server-side (NOT the Public Key).
VAPI_API_KEY=your-private-key-here
# Random secret — must match the value set in Vapi's server URL headers.
VAPI_WEBHOOK_SECRET=generate-a-long-random-string
# false = full production assistant (check_availability + book_appointment + capture_lead + log_emergency)
# true  = spike assistant (capture_lead only, for contract testing)
VAPI_SPIKE_MODE=false
# LLM used inside Vapi for the assistant. gpt-4o-mini is cost-effective for production.
VAPI_LLM_MODEL=gpt-4o-mini

# ─── VOICE ─────────────────────────────────────────────────────────────────
# If set, the full assistant uses ElevenLabs for TTS (better voice quality).
# If not set, the assistant falls back to Vapi's built-in "Elliot" voice (free, no key needed).
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ElevenLabs voice ID to use when ELEVENLABS_API_KEY is set.
DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ─── GOOGLE CALENDAR ───────────────────────────────────────────────────────
# Service account credentials — required for check_availability and book_appointment tools.
# 1. Create a GCP project → enable Google Calendar API
# 2. Create a Service Account → generate a JSON key
# 3. Share your test calendar with the service account email (Editor permission)
G_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key value from the JSON key file. Keep the \n line breaks.
G_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# ─── CLIENT WEBHOOKS ───────────────────────────────────────────────────────
# Where to POST patient lead data after each session (n8n, Zapier, Make, etc.)
MEDICAL_CLINIC_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/medical
MEDICAL_CLINIC_WEBHOOK_SECRET=your-256-bit-hmac-secret

# ─── LLM (BROWSER WIDGET ONLY — legacy Layer B) ────────────────────────────
# Only needed for the frozen browser widget demo, not the phone platform.
OLLAMA_ENDPOINT=http://localhost:11434

# ─── TWILIO (FUTURE) ───────────────────────────────────────────────────────
# Not needed until Twilio number import (Phase 3 — after first client signed).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
